resource "aws_iam_policy" "company_s3_policy" {
  name = "company-s3-policy"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = [
          "s3:GetObject",
          "s3:PutObject"
        ]
        Effect = "Allow"
        Resource = [
          "${aws_s3_bucket.documents.arn}/company/*"
        ]
      }
    ]
  })
}

resource "aws_iam_role_policy_attachment" "company_attach" {
  role       = aws_iam_role.company_role.name
  policy_arn = aws_iam_policy.company_s3_policy.arn
}